# ─── Cilantro CEO Tool - Environment Configuration ───────────────────
#
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.
#

# ─── API Security ────────────────────────────────────────────────────
# Comma-separated list of valid API keys.
# Optional prefix: "admin:key" or "analyst:key" for role-based access.
# Default role (no prefix) is "viewer".
#
# To rotate keys:
#   1. Add new key to list (keep old key)
#   2. Deploy
#   3. Update all clients to use new key
#   4. Remove old key from list
#   5. Deploy again
#
CEO_TOOL_API_KEYS=admin:change-me-admin-key-123,analyst:change-me-analyst-key-456,change-me-viewer-key-789

# ─── Database ────────────────────────────────────────────────────────
# SQLite (MVP):
CEO_TOOL_DATABASE_URL=sqlite:///./cilantro_ceo.db
# PostgreSQL (production):
# CEO_TOOL_DATABASE_URL=postgresql://user:password@localhost:5432/cilantro_ceo

# ─── POS Integration (OPTIONAL) ─────────────────────────────────────
# ASSUMPTION: POS system provides a REST API for daily sales data.
# Leave blank to use CSV uploads as fallback.
#
# CEO_TOOL_POS_API_URL=https://pos.cilantro.com.eg
# CEO_TOOL_POS_API_KEY=your-pos-api-key-here

# ─── Decision Engine Thresholds ──────────────────────────────────────
# Override defaults to tune alert sensitivity.
#
# CEO_TOOL_REVENUE_DROP_THRESHOLD=0.80
# CEO_TOOL_COGS_MAX_PERCENT=0.35
# CEO_TOOL_LABOR_MAX_PERCENT=0.30
# CEO_TOOL_CASH_RUNWAY_MIN_DAYS=14

# ─── Debug Mode ──────────────────────────────────────────────────────
CEO_TOOL_DEBUG=false
